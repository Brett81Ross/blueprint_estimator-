# Rapid Takeoff server-only access signing.
# Use a dedicated random value in production; GEMINI_API_KEY fallback remains only for legacy compatibility in current source.
RAPID_ACCESS_SECRET=generate_a_long_random_rapid_access_secret

# Rapid Takeoff signing-cutover recovery bridge.
# Configure the exact same long random value in CactusByte and Rapid Takeoff before an approved deployment.
# Never expose this value to browser code or with a NEXT_PUBLIC_ prefix.
RAPID_RECOVERY_BRIDGE_SECRET=generate_a_long_random_shared_recovery_secret

# Existing Rapid Takeoff AI provider credential.
GEMINI_API_KEY=your_gemini_api_key
